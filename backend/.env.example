
# =============================================================
# 안내방송 (소방·비상방송 설비와 무관한 독립 시스템)
# =============================================================
BROADCAST_ENABLED=true

# 방송 PC(Agent)를 등록할 때 쓰는 코드. 비워두면 등록 자체가 막힙니다(503).
# 추측 불가능한 긴 문자열로 넣으세요. 예: openssl rand -base64 24
BROADCAST_ENROLL_CODE=

# TTS — openai | local | mock. 교체는 이 값만 바꾸면 됩니다.
BROADCAST_TTS_PROVIDER=openai
BROADCAST_TTS_MODEL=tts-1
# OPENAI_API_KEY 가 있어야 음성 생성이 동작합니다(위 OpenAI 설정 참고)

# 아래는 기본값이 있으니 필요할 때만
# BROADCAST_MAX_UPLOAD_MB=100    # 업로드 음원 상한(MB)
# BROADCAST_MAX_SECONDS=600      # 방송 1건 최대 재생시간(초)
# BROADCAST_OFFLINE_SEC=180      # 이 시간 조용하면 방송 PC 오프라인으로 간주
# BROADCAST_SYNC_DAYS=7          # 미리 내려보낼 예약 기간(=인터넷 끊겨도 버티는 기간)
# BROADCAST_MAX_RETRY=2          # 실패한 방송 재시도 횟수
