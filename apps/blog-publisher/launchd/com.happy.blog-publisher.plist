<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac 에 로그인해 있는 동안 발행기를 계속 띄워 둔다.
       __HOME__ 을 실제 홈 경로로, __PYTHON__ 을 `which python3` 결과로 바꿔서
       ~/Library/LaunchAgents/ 에 넣고 `launchctl load` 한다. README 참고. -->
  <key>Label</key>
  <string>com.happy.blog-publisher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>blog_publisher</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/happy_admin/apps/blog-publisher</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- aside 가 ~/.local/bin 에 있다. launchd 는 셸 PATH 를 모른다 -->
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/BlogPublisher/publisher.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/BlogPublisher/publisher.log</string>
</dict>
</plist>
